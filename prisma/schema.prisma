generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One practice run: the configuration chosen on the setup screen.
model Session {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  endedAt      DateTime?
  status       String     @default("active") // active | scored
  title        String
  product      String
  personaId    String
  personaName  String
  personaBrief String
  difficulty   String // cooperative | skeptical | hostile
  framework    String // meddic | spin | challenger | custom
  customFlow   String?
  language     String     @default("en")
  /// Buying committee as JSON: [{ id, name, title, brief, emoji }]. The first
  /// member is the primary persona. Empty for sessions created before committees.
  members      String     @default("[]")
  messages     Message[]
  decisions    Decision[]
  scorecard    Scorecard?
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // seller | buyer
  /// Committee member id for buyer turns (null = primary persona).
  speaker   String?
  content   String
  /// Live coach hint generated after this buyer turn (JSON array of strings).
  coachHint String?

  @@index([sessionId, createdAt])
}

/// One committee member's decision in one round: what they did, how their
/// interest and trust moved, and why. Silent members get a decision too.
model Decision {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  round       Int
  memberId    String
  /// Buyer message produced by this decision (null if the member stayed silent).
  messageId   String?
  action      String
  addressedTo String
  interest    Int
  trust       Int
  reasoning   String
  /// Private note to colleagues (never shown to the seller during the call).
  whisper     String   @default("")
  /// How the committee adapted this round to the seller's performance.
  adaptation  String   @default("steady")

  @@index([sessionId, createdAt])
}

model Scorecard {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overall   Int
  /// Full evaluator JSON (categories, key moments, rewrites, summary).
  report    String
  /// Committee deal vote as JSON: [{ memberId, vote, headline, objections }].
  verdict   String   @default("[]")
  model     String
}

/// Reusable custom buyer personas saved from the configurator.
model PersonaTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  title     String
  brief     String
}
